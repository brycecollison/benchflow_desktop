# Dependencies
node_modules/
frontend/node_modules/
venv/
.venv/
env/
ENV/

# Build artifacts
dist/
frontend/dist/
build/
*.tsbuildinfo
.vite/

# Python cache & environment
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.mypy_cache/

# Uploaded experimental media & large microscopy datasets (ND2, TIFF) - the web layout's
# folder; this build writes to %LOCALAPPDATA%\Benchflow (app/paths.py)
backend/uploads/*

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local SQLite databases & WAL
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment variables & local configurations
.env
.env.*
!.env.example

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local notebook data (database, JSON snapshot) - lives with the app, never in Git,
# and can be relocated with BENCHFLOW_DATA_DIR (see backend/app/paths.py)
/backend/data/
# --- desktop build (this repo) ---
# 54 MB of seed media: rebuilt by packaging\build.ps1 from the web repo.
# (Files already tracked from the first vendor commit stay tracked; this rule keeps
# rebuilt/regenerated ones out of the next commit.)
/seed/uploads/
# The notebook itself is small and is what a clean machine imports on first run,
# so it is version-controlled despite the `*.db` rule above.
!/seed/benchflow.db
/packaging/build/
/packaging/dist/
/packaging/output/
